# Depot jarvis-automates. Racine C:\Obsidian.
# Le coffre a son propre depot, second-brain. On ne le suit pas ici.
Second Brain/

# Ce qui tourne et se regenere a chaque passage
*/journal*.log
*/travail/
*/contexte.txt
*/agenda.txt
*/index.txt
*/verrou.txt
__pycache__/
*.pyc

# Les identifiants, ou qu'ils soient. Le pont agenda de matin/ en depose un.
*.local.*
.env
.env.*

# Le miroir des skills : jamais de dependances ni de cles
miroir/**/node_modules/
miroir/**/*.local.*
miroir/**/.env
miroir/**/.env.*

# Les clones de depots distants, ils se regenerent en une commande
captures/depot/

# Le compte Claude releve par le passage : un etat local, pas une consigne
bibliothecaire/compte.txt
